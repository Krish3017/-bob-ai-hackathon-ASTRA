# Database Connection
DATABASE_URL=postgresql://postgres:your_password@your_supabase_db:5432/postgres
DIRECT_URL=postgresql://postgres:your_password@your_supabase_db:5432/postgres

# Server Settings
APP_PORT=8000
APP_HOST=0.0.0.0
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase Settings (Optional - fallback in-memory repository is active by default)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key

# Authentication / Security
JWT_SECRET=super-secret-naviops-hackathon-key-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
